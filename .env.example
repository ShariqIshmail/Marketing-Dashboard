# Marketing Dashboard Environment Variables

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketing_dashboard
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Backend
NODE_ENV=development
BACKEND_PORT=5000

# Agent Service (Python)
AGENT_SERVICE_PORT=5001
AGENT_SERVICE_HOST=http://localhost:5001

# Claude API (for agents and web search)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Google Ads Integration (optional, for future use)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Meta Ads Integration (optional, for future use)
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# App Settings
APP_NAME=Marketing Dashboard
COMPETITORS_LIST=Competitor1,Competitor2,Competitor3
AGENT_RUN_SCHEDULE=0 7 * * *
