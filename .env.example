# AdPulse – paid ads dashboard settings
# Copy this file to .env and fill in the platforms you use. Restart after editing.

# API server port (the dashboard itself runs on http://localhost:5173 in dev)
PORT=5000

# How often to pull data from the ad platforms (cron syntax). "off" disables it.
SYNC_SCHEDULE=0 */6 * * *
# Days re-pulled on every sync, so late-attributed conversions are captured
SYNC_LOOKBACK_DAYS=30

# ---- Google Ads ----
# Developer token: Google Ads UI > Tools > API Center (needs Basic access approval)
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# The ad account to report on, e.g. 123-456-7890
GOOGLE_ADS_CUSTOMER_ID=
# Only if you access the account through a manager (MCC) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: API version (Google retires versions roughly yearly)
GOOGLE_ADS_API_VERSION=v21

# ---- Meta Ads (Facebook / Instagram) ----
# System user token with ads_read permission (Business Settings > System users)
META_ACCESS_TOKEN=
# Ad account ID, with or without the act_ prefix
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0
# Optional: which action types count as conversions (first match wins)
# META_CONVERSION_ACTIONS=omni_purchase,purchase,offsite_conversion.fb_pixel_purchase

# ---- LinkedIn Ads ----
# OAuth token with r_ads_reporting and r_ads scopes (Marketing Developer Platform access)
LINKEDIN_ACCESS_TOKEN=
# Sponsored account ID (number from Campaign Manager URL)
LINKEDIN_AD_ACCOUNT_ID=
# Optional: LinkedIn API version, YYYYMM
LINKEDIN_API_VERSION=202509
